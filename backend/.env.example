# Copy to .env (which is gitignored) and fill in real values.
# Passwords come from db/init.sql.

# Runtime: the app role. It must NOT own the tables, so row-level security cannot be bypassed.
DATABASE_URL=postgresql+psycopg://app_user:CHANGE_ME@localhost:5432/expense_tracker

# Migrations only: the owner role.
MIGRATION_DATABASE_URL=postgresql+psycopg://expense_owner:CHANGE_ME@localhost:5432/expense_tracker

# Access-token signing key, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRE_MINUTES=60

# Vision model that reads receipts. Leave the key empty to run without it:
# uploads then end as `failed` and receipts are entered by hand.
# Model names change over time: Google retires older ones for new keys. Check the list in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: a second model tried when the first is overloaded or unavailable.
GEMINI_FALLBACK_MODEL=

# Today's exchange rate in LBP per USD. Saved on each receipt when it is confirmed, so changing it
# later does not change old receipts. Check the current rate before relying on this value.
DEFAULT_LBP_PER_USD=89500

# Folder for uploaded receipt files.
UPLOAD_DIR=uploads

# AI-generated SQL only: the read-only role (needed once the assistant is built).
READONLY_DATABASE_URL=postgresql+psycopg://ai_readonly:CHANGE_ME@localhost:5432/expense_tracker
