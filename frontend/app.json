{
  "expo": {
    "name": "Fatourati",
    "slug": "fatourati",
    "scheme": "fatourati",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5e54a",
          "image": "./assets/splash/wordmark-large.png",
          "imageWidth": 284,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#f5e54a",
            "image": "./assets/splash/wordmark-large.png"
          }
        }
      ],
      "expo-asset"
    ]
  }
}
