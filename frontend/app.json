{
  "expo": {
    "name": "Fatourati",
    "slug": "fatourati",
    "scheme": "fatourati",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Fatourati uses the camera to scan your receipts.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fatourati reads the receipt photos you choose.",
          "cameraPermission": "Fatourati uses the camera to scan your receipts."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-asset"
    ]
  }
}
