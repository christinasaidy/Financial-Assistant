# Copy this file to .env and fill in your laptop's address on the Wi-Fi.
#
# The iPhone (Expo Go) talks to the backend directly, so it must reach the laptop: both on the same Wi-Fi,
# the backend started on all interfaces (uvicorn ... --host 0.0.0.0 --port 8000), and Windows Firewall
# allowing port 8000 on private networks. Find the laptop's IP with `ipconfig` (IPv4 Address, e.g. 192.168.1.23).
# "localhost" does not work: on the phone it means the phone itself.
EXPO_PUBLIC_API_URL=http://<your-laptop-LAN-IP>:8000
